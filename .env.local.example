# Claude API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── 접근 인증 (필수) ───────────────────────────────────────────────
# Atlassian OAuth 2.0 (3LO) 앱 자격증명
# developer.atlassian.com → Your apps → Authorization → Callback URL:
#   https://<배포도메인>/api/auth/atlassian/callback
#   http://localhost:3000/api/auth/atlassian/callback
# 필요 스코프: read:me, read:page:confluence, read:space:confluence, offline_access
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# 세션 쿠키 서명/암호화 키 (openssl rand -base64 32)
ATLASSIAN_SESSION_SECRET=
# 접근 세션 서명 키. 미설정 시 ATLASSIAN_SESSION_SECRET을 사용한다.
AUTH_SESSION_SECRET=

# 로그인 허용 이메일 도메인 (쉼표 구분, 기본값 musinsa.com — 서브도메인 포함)
ALLOWED_EMAIL_DOMAINS=musinsa.com
# 도메인 정책 예외로 개별 허용할 이메일 (쉼표 구분, 선택)
ALLOWED_EMAILS=
