# 이 파일을 .env.local로 복사해서 쓰세요.

ANTHROPIC_API_KEY=sk-ant-...

# 채점에 쓰는 모델.
#
# ⚠️ 이 값이 코드의 기본값을 이깁니다. 여기 적힌 모델이 실제로 채점합니다.
#    코드에는 새 모델이 적혀 있는데 여기에 옛 모델이 남아 있어서, 바꾼 줄 알고
#    37분짜리 측정을 옛 모델로 돌린 사고가 있었습니다 (변경 기록 21번).
#
# 확인 방법 — 앱을 띄운 뒤 아래를 실행하면 실제로 응답한 모델이 나옵니다.
#    curl 'http://localhost:3000/api/analyze?probe=model'
#
# 고정할 이유가 없으면 이 줄을 지우세요. 그러면 코드의 기본값을 씁니다.
ANTHROPIC_MODEL=claude-sonnet-5

# AI의 "생각 기능"을 끌지 여부.
#
# ⚠️ 이 값도 채점 결과에 큰 영향을 줍니다. 켜져 있으면 같은 문서를 다시 넣었을 때
# 점수가 5~7점씩 달라졌고, 끄면 1~4점으로 줄었습니다 (변경 기록 22번).
# 이 앱이 재는 것이 "같은 문서를 여러 번 넣어도 점수가 흔들리지 않는가"이므로
# 기본값을 disabled로 둡니다. 지우면 모델의 기본 동작(생각 기능 켜짐)을 씁니다.
ANTHROPIC_THINKING=disabled

# ── Atlassian(Confluence) 연동 ────────────────────────────────
#
# 이 3개가 없으면 Confluence URL 탭을 쓸 수 없습니다.
# (파일 업로드 탭은 이 값들 없이도 정상 동작합니다.)
#
# 사내 위키 wiki.team.musinsa.com은 커스텀 도메인을 쓰는 Atlassian Cloud라
# 아래 OAuth 2.0 (3LO) 방식이 그대로 적용됩니다.
#
# 발급 절차 — https://developer.atlassian.com/console/myapps/
#   1) Create → OAuth 2.0 integration
#   2) Permissions → Confluence API 추가 후 아래 scope 활성화
#        read:page:confluence
#        read:space:confluence
#      (offline_access는 코드가 자동 요청하므로 별도 설정 불필요)
#   3) Authorization → OAuth 2.0 (3LO) → Callback URL 등록
#        http://localhost:3000/api/auth/atlassian/callback
#      ※ 한 글자도 달라선 안 됩니다. 콜백 주소는 접속한 주소에서 그대로
#        조립되므로(atlassian-auth.ts buildCallbackUri), 반드시 127.0.0.1이
#        아닌 localhost로, 포트도 3000으로 접속해야 합니다.
#      ※ 콜백 주소는 한 앱에 최대 30개까지 한 줄에 하나씩 넣을 수 있습니다
#        (콘솔 화면의 "Enter up to 30 redirect URIs, one per line"에서 확인).
#        따라서 운영 앱에 로컬 주소를 덧붙여 쓰는 것도 가능합니다. 다만
#        운영 설정을 건드리는 위험이 있어 로컬 전용 앱을 따로 만드는 쪽을
#        권합니다.
#   4) Settings에서 Client ID / Secret 복사
#      Client ID는 인증 URL에 그대로 드러나는 공개값이고,
#      Secret만 이 화면에서 얻을 수 있습니다.
#
# ※ Access type은 Resource-level을 고릅니다. 코드가 accessible-resources로
#   사이트 목록을 받은 뒤 /ex/confluence/{cloudId}/... 를 호출하는 방식이라
#   Resource-level(classic 3LO) 흐름과 맞습니다. Account-level은 계정 전체
#   접근이라 이 앱에 필요 없습니다.
#
# ※ 콘솔이 "doesn't have any classic scopes"라고 경고해도 무시합니다.
#   이 앱은 v2 API(/wiki/api/v2/pages/{id})를 쓰므로 granular scope가 맞고,
#   classic scope는 v1용이라 추가할 필요가 없습니다.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# 세션 쿠키 암호화용 임의 문자열 — 외부에서 발급받는 값이 아닙니다.
# 아래 명령으로 직접 만들어 쓰세요. 프로덕션과 같을 필요 없습니다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ATLASSIAN_SESSION_SECRET=
